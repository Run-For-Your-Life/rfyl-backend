{
  "main": "dist/index.js",
  "name": "rfyl-backend",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build --silent && node dist/index.js\"",
    "dev:local": "ENV_FILE=../.env.local npm run dev",
    "dev:cloud": "ENV_FILE=../.env npm run dev",
    "start": "node dist/index.js",
    "db:local:up": "docker compose -f docker-compose.local-db.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local-db.yml down",
    "db:local:logs": "docker compose -f docker-compose.local-db.yml logs -f mysql",
    "test:integration:db": "sh -c 'npm run db:local:up; status=0; node tests/realtime.persistence.integration.test.js || status=$?; npm run db:local:down; exit $status'",
    "test:all": "npm test && npm run test:integration:db",
    "test": "node tests/smoke.test.js && node tests/build.test.js && node tests/src-structure.test.js && node tests/auth.integration.test.js && node tests/realtime.capture.test.js && node tests/realtime.gameplay.test.js && node tests/realtime.persistence.test.js && node tests/map.reset.test.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@turf/bbox": "^7.3.2",
    "@turf/boolean-point-in-polygon": "^7.3.2",
    "@turf/difference": "^7.3.3",
    "@turf/helpers": "^7.3.3",
    "@turf/line-intersect": "^7.3.2",
    "@turf/polygon-to-line": "^7.3.2",
    "@turf/union": "^7.3.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.0.2",
    "mysql2": "^3.15.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
